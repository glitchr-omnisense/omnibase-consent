{#
 # The cookie answer (omnibase/consent): a small circle that opens a panel -
 # what the site keeps, accept, refuse, customize. A visitor who has not
 # answered yet sees the panel float at the bottom of the screen, counted
 # down (consent.countdown): no answer is the answer of
 # consent.countdown_action. Refused, what a feature keeps is erased and is
 # not written again.
 #
 # {% include '@Consent/_cookie.html.twig' with {place: 'footer'} %}
 #
 #   place     tells two circles of a page apart (the panel's id: ga-cookie-<place>)
 #   floating  false: this circle never floats by itself (another one of the page does)
 #   icon      the circle's content (HTML); a cookie drawn in SVG by default
 #
 # The panel is the banner of @glitchr/flowjs/cookie, whose attributes are
 # written here with the prefix data-consent (consent.js names the ones that
 # differ): the question (data-consent-summary) and, under "Personnaliser",
 # the detailed section (data-consent-section) - one row per feature
 # (<template data-consent-row>) with its switch and what it keeps. The
 # features are the bundle's own (config/features.php), the site's
 # (consent.groups, consent.features) and those scripts declare as they run
 # (window.Consent.use()); the <script type="application/json"> hands them
 # to the library with their words.
 #
 # A page whose scripts are from before that library (a core that still packs
 # @glitchr/cookie) is served by consent-legacy.js, which reads the
 # data-consent-* attributes of the circle and the two parts marked "legacy".
 #
 # Anything with `data-consent-open` (a "Cookies" link of a sitemap) opens the panel.
 # The look: bundles/consent/css/consent.css, themed by --consent-* properties.
 #}
{% set _options = consent_options() %}
{% set _id = 'ga-cookie-' ~ (place ?? 'footer') %}
<link rel="stylesheet" href="{{ asset('bundles/consent/css/consent.css') }}">
<div class="ga-cookie" data-consent data-consent-groups="{{ _options.groups|json_encode }}" data-consent-features="{{ _options.features|json_encode }}" data-consent-labels="{{ _options.labels|json_encode }}" data-consent-countdown="{{ _options.countdown }}" data-consent-erase="{{ _options.erase|json_encode }}" data-consent-dismiss="{{ _options.dismiss }}" data-consent-ignore="{{ _options.ignore|json_encode }}"{% if (floating ?? true) is same as(false) %} data-consent-floating="false"{% endif %}>
    <button type="button" class="ga-cookie-button" data-consent-toggle aria-expanded="false" aria-controls="{{ _id }}" aria-label="{{ '@consent.label'|trans }}"
            data-accepted-label="{{ '@consent.accepted'|trans }}" data-refused-label="{{ '@consent.refused'|trans }}" title="{{ '@consent.accepted'|trans }}">
        {%- if icon is defined -%}{{ icon|raw }}{%- else -%}
        <svg class="ga-cookie-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5Zm-3.5 7a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Zm6 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Zm-5 3a1 1 0 1 1 0 2 1 1 0 0 1 0-2Z"/></svg>
        {%- endif -%}
    </button>
    <div class="ga-cookie-panel" id="{{ _id }}" data-consent-banner hidden>
        <div class="ga-cookie-summary" data-consent-summary role="dialog" aria-label="{{ '@consent.label'|trans }}">
            <p class="ga-cookie-text" data-consent-text="text">{{ '@consent.text'|trans({privacy: _options.privacy ?? 'none'})|raw }}</p>
            {# legacy: the switches consent-legacy.js builds #}
            <ul class="ga-cookie-features" aria-label="{{ '@consent.details'|trans }}" hidden></ul>
            {% if _options.countdown > 0 %}<p class="ga-cookie-implicit" data-consent-counting>{{ ('@consent.' ~ (_options.action == 'refuse' ? 'implicit_refuse' : 'implicit'))|trans({count: '<span class="ga-cookie-count" data-consent-count>' ~ _options.countdown ~ '</span>'})|raw }}</p>{% endif %}
            <div class="ga-cookie-actions">
                <button type="button" class="ga-cookie-accept" data-consent-accept data-consent-text="accept">{{ '@consent.accept'|trans }}</button>
                <button type="button" class="ga-cookie-refuse" data-consent-refuse data-consent-text="refuse">{{ '@consent.refuse'|trans }}</button>
            </div>
            <div class="ga-cookie-more">
                {# Hidden as written: shown by consent.js, and by consent-legacy.js from two features on. #}
                <button type="button" class="ga-cookie-details" data-consent-details data-consent-text="customize" aria-expanded="false" hidden>{{ '@consent.details'|trans }}</button>
                {# legacy: keeps the switches of consent-legacy.js #}
                <button type="button" class="ga-cookie-save" data-consent-save hidden>{{ '@consent.save'|trans }}</button>
            </div>
        </div>
        <div class="ga-cookie-section" data-consent-section hidden>
            <p class="ga-cookie-title" data-consent-text="detailsTitle">{{ '@consent.choices'|trans }}</p>
            <ul class="ga-cookie-categories" data-consent-categories></ul>
            <template data-consent-row>
                <li class="ga-cookie-category">
                    <label class="ga-cookie-category-head">
                        <input type="checkbox" data-consent-switch>
                        <span class="ga-cookie-category-text">
                            <strong data-consent-label></strong>
                            <em class="ga-cookie-required" data-consent-required>{{ '@consent.required'|trans }}</em>
                            <small data-consent-description></small>
                        </span>
                    </label>
                    <details class="ga-cookie-stored">
                        <summary>{{ '@consent.stored'|trans }}</summary>
                        <ul class="ga-cookie-entries" data-consent-entries></ul>
                        <ul class="ga-cookie-governs" data-consent-governs></ul>
                    </details>
                </li>
            </template>
            <div class="ga-cookie-actions">
                {# data-consent-all, not -accept / -refuse: a circle has one "accept" and one "refuse", the question's. #}
                <button type="button" class="ga-cookie-accept" data-consent-all="accept" data-consent-text="acceptAll">{{ '@consent.accept_all'|trans }}</button>
                <button type="button" class="ga-cookie-refuse" data-consent-all="refuse" data-consent-text="refuseAll">{{ '@consent.refuse_all'|trans }}</button>
            </div>
            <div class="ga-cookie-more">
                <button type="button" class="ga-cookie-close" data-consent-close data-consent-text="close">{{ '@consent.close'|trans }}</button>
                <button type="button" class="ga-cookie-keep" data-consent-keep data-consent-text="save">{{ '@consent.save'|trans }}</button>
            </div>
        </div>
    </div>
</div>
<script type="application/json" data-consent-settings>{{ consent_settings() }}</script>
<script src="{{ asset('bundles/consent/js/consent-legacy.js') }}" defer></script>
<script src="{{ asset('bundles/consent/js/consent.js') }}" defer></script>
