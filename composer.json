{
    "name": "omnibase/consent",
    "description": "The cookie answer of every omnibase site, in one place: a small circle, a panel, the features the visitor answers for and what each keeps, a countdown, on @glitchr/flowjs/cookie.",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [{"name": "Marco Meyer", "email": "marco.meyer@glitchr.io"}],
    "require": {
        "php": "^8.2",
        "omnibridge/symfony": "1.x-dev",
        "omniscient/omnibase": "3.0.*-dev || 4.0.*-dev",
        "twig/twig": "^3.0"
    },
    "autoload": {
        "psr-4": {"Base\\Consent\\": "./src"}
    },
    "autoload-dev": {
        "psr-4": {"Base\\Consent\\Tests\\": "./tests"}
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
